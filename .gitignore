# sermon-workflows .gitignore

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Virtual environments
.venv/
venv/
env/

# Environment / secrets
.env
.env.*
*.pem
*.key
*secret*
*credentials*
*token*

# Output / generated files
output/
outputs/
dist/
build/
.cache/
reports/
backups/

# Temporary / scratch
tmp/*.md
tmp/*.txt
tmp/*.log
tmp/prompts/
tmp/slides/

# Logos capture raw files are intentionally allowed for selected research assets:
# tmp/logos-capture/raw/**
# tmp/logos-capture/validated/**

# Ollama / local model files
.ollama/
models/

# OS / editor
.DS_Store
Thumbs.db
.vscode/settings.json
.vscode/launch.json
.idea/

# Logs
*.log
logs/

# Local PC performance diagnostics (not sermon workflow source)
docs/windows-performance-optimization.md
scripts/apply_safe_performance_profile.ps1
scripts/check_windows_performance.ps1
scripts/rollback_safe_performance_profile.ps1

# Backup files
*.bak
*.backup

# ──────────────────────────────────────────────────────────────
# sermon-workflows .gitignore — 95점 버전
# ──────────────────────────────────────────────────────────────

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Virtual environments
.venv/
venv/
env/

# Environment / secrets (절대 커밋 금지)
.env
.env.*
*.pem
*.key
*secret*
*credentials*
*token*

# Output / generated files (재생성 가능)
output/
outputs/
dist/
build/
.cache/

# Temporary / scratch
tmp/*.md
tmp/*.txt
tmp/*.log
tmp/prompts/
tmp/slides/

# ★ Logos 캡처 원본은 연구 자산 — 포함 유지
# tmp/logos-capture/raw/**  → git에 포함
# tmp/logos-capture/validated/**  → git에 포함
# tmp/logos-capture/*.md (classification 등 생성물) → 제외 (위에서 처리)

# Ollama / local model files
.ollama/
models/

# OS / editor
.DS_Store
Thumbs.db
.vscode/settings.json
.vscode/launch.json
.idea/

# Logs
*.log
logs/

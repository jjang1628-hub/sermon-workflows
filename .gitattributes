# ──────────────────────────────────────────────────────────────
# sermon-workflows .gitattributes — 줄 끝 정규화 95점 버전
# ──────────────────────────────────────────────────────────────

# 기본: 텍스트 파일은 LF로 정규화
* text=auto

# 코드/텍스트 → LF
*.py   text eol=lf
*.md   text eol=lf
*.txt  text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.toml text eol=lf
*.csv  text eol=lf

# Windows 전용 스크립트 → CRLF
*.ps1  text eol=crlf
*.bat  text eol=crlf
*.cmd  text eol=crlf

# 바이너리 (diff/merge 안 함)
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.ico    binary
*.pdf    binary
*.zip    binary
*.pptx   binary
*.xlsx   binary
*.docx   binary
